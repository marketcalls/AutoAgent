# AutoAgent - environment template
# Copy to .env and fill in the blanks. .env is gitignored; this file is not.
#
# The backend reads .env ONCE at startup. Restart it after any change.

# ---------------------------------------------------------------------------
# OpenAlgo
# ---------------------------------------------------------------------------
# Get the API key from the running OpenAlgo web app after logging in with your broker.
OPENALGO_API_KEY=
OPENALGO_HOST=http://127.0.0.1:5000
OPENALGO_WS_URL=ws://127.0.0.1:8765
OPENALGO_API_VERSION=v1
# Seconds. The SDK default is 120, far too long for a system that must decide on a
# 5-minute bar close.
OPENALGO_TIMEOUT=15
OPENALGO_INSTRUMENTS_TIMEOUT=30

# ---------------------------------------------------------------------------
# Model - LiteLLM, so any provider works (cloud or local)
# ---------------------------------------------------------------------------
# There is ONE key and ONE optional base URL. The PREFIX on LITELLM_MODEL decides
# the provider, and LITELLM_API_KEY is that provider's key, whichever it is.
#
# The Planner needs TOOL CALLING. Any model you pick must support it.
#
# IMPORTANT, and different from TradingAgent: the model NEVER places an order here.
# It reads the regime, writes the morning plan, and proposes a risk fraction inside a
# bounded band. Every signal, entry, exit and stop is deterministic Python. A model
# outage at 08:45 means no plan, which means no session - a safe failure, not a
# position left unmanaged.

LITELLM_MODEL=baseten/deepseek-ai/DeepSeek-V4-Flash-0731
LITELLM_API_KEY=
# Leave empty to use the provider's own default endpoint. Only set it to override.
LITELLM_API_BASE=

LITELLM_TEMPERATURE=0.2
LITELLM_TOP_P=1.0
# For a reasoning model this is load-bearing: too small and the whole budget goes to
# hidden reasoning, so the reply comes back EMPTY rather than short.
LITELLM_MAX_TOKENS=4096
# Sends stream_options={"include_usage": true} for token accounting. Skipped
# automatically for local providers, which reject unknown fields.
LITELLM_INCLUDE_USAGE=1

# Thinking / reasoning effort. Empty leaves the provider's own default alone.
# Values: none | minimal | low | medium | high
#
# Whether this does anything depends on the MODEL, and the app works it out for you.
# Two separate questions: does the model reason at all, and does the provider accept
# the reasoning_effort parameter. If either answer is no, the setting is ignored with
# a warning in the log.
#
#   Ollama, tool-capable model  -> Off / On. LiteLLM maps effort onto Ollama's boolean
#                                  `think` flag, so low/medium/high all just mean "on".
#                                  Measured on gemma4:e4b: 1869 thinking chars and
#                                  18.4s, down to 0 and 6.7s with none. Worth setting.
#   openai/o3, claude-sonnet-4-5 -> full scale.
#   openai/gpt-4o, groq llama    -> nothing; not reasoning models.
#   baseten DeepSeek V4 Flash    -> nothing. It DOES reason, but Baseten rejects the
#                                  parameter outright (UnsupportedParamsError), so the
#                                  amount cannot be controlled at all.
#
# If you measure this yourself, do NOT set litellm.drop_params = True: it silently
# discards reasoning_effort, so every level becomes the same request and any difference
# you see is noise.
LITELLM_REASONING_EFFORT=

# --- How to configure each provider ----------------------------------------
#
# 1. BASETEN (the default)
#    LITELLM_MODEL=baseten/deepseek-ai/DeepSeek-V4-Flash-0731
#    LITELLM_API_KEY=<your baseten key>
#    LITELLM_API_BASE=
#
# 2. OPENAI
#    LITELLM_MODEL=openai/gpt-5.6-sol        (or openai/gpt-5.6-luna, openai/o3, openai/gpt-4o)
#    LITELLM_API_KEY=sk-<your openai key>
#    LITELLM_API_BASE=
#
#    NOTE for the gpt-5.6 family (-sol and -luna): on /v1/chat/completions they refuse
#    to combine function tools with any reasoning effort except "none". Thinking is
#    pinned off for them automatically; a stray LITELLM_REASONING_EFFORT is overridden
#    with a warning.
#
# 3. LOCAL, via OLLAMA - no key at all
#    Start it with `ollama serve`, pull a TOOL-CAPABLE model, then:
#    LITELLM_MODEL=ollama_chat/llama3.1
#    LITELLM_API_KEY=
#    LITELLM_API_BASE=
#
#    Use the ollama_chat/ prefix, not ollama/. Check tool support with
#    `ollama show <model>` and look for "tools" in the capabilities list; the app
#    reads that at startup and tells LiteLLM, because LiteLLM's own model table is
#    stale and would otherwise fall back to a broken JSON-emulation path.
#    A remote Ollama box:  LITELLM_API_BASE=http://192.168.1.50:11434
#
# Other providers follow the same shape - set the prefix and the one key:
#    anthropic/claude-sonnet-5 | gemini/gemini-3-pro | groq/llama-3.3-70b-versatile
#    openrouter/anthropic/claude-sonnet-5 | lm_studio/<model>
# Any OpenAI-compatible endpoint:
#    LITELLM_MODEL=openai/<model>   LITELLM_API_BASE=https://your-host/v1

# ---------------------------------------------------------------------------
# Capital - the single most important difference from TradingAgent
# ---------------------------------------------------------------------------
# ALLOCATION is what this agent trades. It is NOT read from the broker, ever.
#
# TradingAgent sizes against available funds because a human approves each order and
# can see the number. This agent runs unattended, so it trades a slice you carve out
# in advance. If your account holds 1 crore and ALLOCATION is 10 lakh, every risk
# figure below is a percentage of 10 lakh.
#
# Sizing against broker funds on a funded account would produce positions an order of
# magnitude larger than intended, silently. Rupees, not percent.
ALLOCATION=1000000

# Pre-open assertion. The session refuses to start if broker availablecash is below
# this. Set equal to ALLOCATION unless you deliberately want a buffer requirement.
REQUIRE_FUNDS_AT_LEAST=1000000

# ---------------------------------------------------------------------------
# Risk controls - deterministic Python, no prompt involved, before every order
# ---------------------------------------------------------------------------
# Master switch. false means the executor cannot place orders at all.
TRADING_ENABLED=false
# Refuse every order while OpenAlgo is in live mode. Keep true until you mean it.
REQUIRE_ANALYZER_MODE=true
# Tags orders in the OpenAlgo order book so they are attributable. With no client
# order id available in the SDK (verified at step 0), this plus symbol, side, quantity
# and a time window IS the reconciliation key.
DEFAULT_STRATEGY_NAME=AutoAgent

# --- Position sizing -------------------------------------------------------
# Risk per trade as a fraction of ALLOCATION. 0.005 = 0.5% = 5,000 rupees on 10 lakh.
# Quantity is derived: risk_amount / stop_distance, so a wider stop buys fewer shares
# and volatility sizes the position automatically.
RISK_FRACTION_BASE=0.005
# The Planner may scale risk DOWN within [FLOOR, BASE] and never above BASE. If it
# returns nothing, or something out of range, the system uses the FLOOR.
RISK_FRACTION_FLOOR=0.00125

# --- Daily loss budget -----------------------------------------------------
# Percent of ALLOCATION. Checked BEFORE every entry as a remaining budget, not after
# the fact as a tripwire: at -1.8% against a 2% limit, a trade risking 0.5% would
# reach -2.3% in the worst case, so it is refused rather than permitted and regretted.
# Loss means realized PLUS unrealized, marked continuously.
DAILY_LOSS_LIMIT_PCT=2.0

# INVARIANT, checked at startup:
#   MAX_CONCURRENT_POSITIONS * RISK_FRACTION_BASE <= DAILY_LOSS_LIMIT_PCT / 100
# At 0.5% risk and a 2% limit that allows 4, and 3 leaves headroom for the slippage
# you pay when a breaker flattens at market. Five concurrent would be 2.5% and breaks
# the limit, which is why a five-symbol basket is a candidate pool, not a target.
MAX_CONCURRENT_POSITIONS=3
MAX_TRADES_PER_DAY=6

# Graduated response before the hard stop. Pause after 2 losses, halt after 3.
# A loss is NET OF COSTS: 50 rupees gross against 80 in brokerage is a loss.
CONSECUTIVE_LOSS_PAUSE=2
CONSECUTIVE_LOSS_HALT=3
PAUSE_MINUTES=30
# Trades inside +/- this many R count as neither win nor loss. Without a scratch band
# noise resets the streak counter constantly.
SCRATCH_BAND_R=0.1

# --- Exposure --------------------------------------------------------------
# Five Indian equities traded by a trend-following strategy are heavily correlated:
# effective diversification is nearer 1.5-2 independent bets than 5. These are the
# cheap mitigations.
MAX_PER_SECTOR=2
# No new longs while the index is below its own trend filter, no new shorts above it.
MARKET_FILTER_SYMBOL=NIFTY
MARKET_FILTER_EXCHANGE=NSE_INDEX

# --- Ported from TradingAgent's RiskGuard -----------------------------------
# Same checks, one changed denominator. In TradingAgent the affordability guard
# compares required margin against a share of BROKER funds. Here it compares against
# ALLOCATION minus realized loss today. Set 0 to disable.
MAX_ORDER_PCT_OF_FUNDS=90

# Absolute ceilings, OPT-IN. 0 means no ceiling, which is the default. The
# account-relative guard above is the real protection; these are a hard backstop.
MAX_ORDER_VALUE=0
# Per-position notional ceiling, as a percent of ALLOCATION.
# Risk-based sizing alone is unbounded as the stop tightens, and tight stops are
# the common case on 5m bars. Measured at step 3: a 2-rupee stop on a 1,300-rupee
# stock gives 2,500 shares, 32.5 lakh of notional against a 10 lakh allocation.
# Risk controls the loss; this controls the size. 0 disables.
MAX_POSITION_NOTIONAL_PCT=100

MAX_ORDER_QUANTITY=0
MAX_ORDERS_PER_SESSION=25
# Reject a LIMIT price more than this percent away from LTP.
MAX_PRICE_DEVIATION_PCT=20
# Suppress an identical order repeated within this many seconds. Second line of
# defence behind the deterministic intent id; note the fingerprint stringifies
# quantity, so 10 and 10.0 do not match.
DUPLICATE_ORDER_WINDOW_SEC=10

# Cash equity intraday only. Index exchanges are quote-only and must never be traded.
ALLOWED_EXCHANGES=NSE,BSE
ALLOWED_PRODUCTS=MIS
SYMBOL_DENYLIST=

# Creating this file stops every order immediately, without restarting, and drives
# the executor to reduce-only and then flat.
KILL_SWITCH_FILE=data/KILL

# ---------------------------------------------------------------------------
# Session clock - Asia/Kolkata
# ---------------------------------------------------------------------------
# The first 5-minute bar closes at 09:20, so no signal can exist before then and
# START_TIME cannot be earlier. 09:30 lets the open settle.
START_TIME=09:30
# Last entry. Positions opened after this have too little session left to work.
END_TIME=14:45
# Force flat at market. Deliberately clear of the 15:15 cutoff after which the
# OpenAlgo sandbox rejects MIS orders, and of broker auto-squareoff timing, which
# you should never rely on.
SQUAREOFF_TIME=15:10
# Fixed. The strategies, the warm-up maths and the backtests all assume 5m.
TIMEFRAME=5m

# ---------------------------------------------------------------------------
# Basket - SYMBOL:SECTOR, comma separated, in PRIORITY ORDER
# ---------------------------------------------------------------------------
# Five liquid names, reviewed weekly rather than rebuilt daily: a basket that changes
# every morning makes each day's backtest describe a different portfolio.
#
# Priority order is the tie-break when several symbols signal on the same bar close
# and the budget cannot fund them all. Deterministic on purpose - ranking by "signal
# strength" would be a new parameter with no measured justification.
#
# SECTOR feeds MAX_PER_SECTOR. Two banks is one bet.
BASKET=RELIANCE:ENERGY,HDFCBANK:BANK,INFY:IT,TMCV:AUTO,SBIN:BANK

# ---------------------------------------------------------------------------
# Strategy selection - run once, pre-open, then LOCKED for the session
# ---------------------------------------------------------------------------
# Two lookback windows because their disagreement is itself information: a strategy
# strong over 90 sessions and weak over 15 is in a regime change.
LOOKBACK_LONG_SESSIONS=90
LOOKBACK_SHORT_SESSIONS=15
# Measured at step 5, not guessed. Left empty until then.
#   REGIME_ADX_FLOOR   below this the system trades nothing
#   HYSTERESIS_MARGIN  how far a challenger must beat the incumbent to switch
REGIME_ADX_FLOOR=25
HYSTERESIS_MARGIN=0.05

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Port 8090 so AutoAgent and TradingAgent can run side by side.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8090
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
LOG_LEVEL=INFO
DB_PATH=data/autoagent.db
AUDIT_DIR=data/audit
# Historical 5m bars. Immutable once a session closes, so they are stored on disk and
# only the newest session is fetched each morning. Measured at step 0: one history
# call returned 4,698 bars across 63 sessions for 90 calendar days.
BARS_DIR=data/bars
TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# Alerts - push, not pull. Nobody is watching a screen.
# ---------------------------------------------------------------------------
# Sent on: plan published, session start, any halt, breaker trip, unreconciled state,
# and the end-of-day summary. OpenAlgo relays these; no extra credentials needed.
# Your OpenAlgo login id, used as the Telegram notify target.
OPENALGO_TELEGRAM_USERNAME=
# Default WhatsApp recipient, digits with country code, e.g. 919876543210.
WHATSAPP_DEFAULT_TO=
